# ChatBI 环境变量（SDD §6.2）
# cp .env.example .env 后填入真实值

# 数据库（生产换成 Supabase 连接串）
DATABASE_URL=postgresql+psycopg://chatbi:chatbi@db:5432/chatbi
DATABASE_RO_URL=postgresql://chatbi_ro:chatbi_ro@db:5432/chatbi
# L0 introspection 专用只读串（可选，缺省回落 DATABASE_RO_URL）
DATABASE_META_URL=

# LLM 三元组（OpenAI 兼容）+ 三档模型名
LLM_BASE_URL=
LLM_API_KEY=
MODEL_SMALL=qwen3.8-flash
MODEL_STRONG=qwen3.8-flash
MODEL_MID=qwen3.8-flash

# Embedding 三元组 + 维度（维度必须与 pgvector 建表一致）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBED_MODEL=qwen3.7-text-embedding
EMBED_DIM=1536

# 执行与检索
QUERY_TIMEOUT_MS=5000
MAX_ROWS=1000
CACHE_TTL_SECONDS=604800
PGVECTOR_ENABLED=auto

# true 时算法走 MockLLM，不发真实请求；单测保持 true，本地联调与验收置 false
USE_MOCK_LLM=true

# Postgres（db 容器）
POSTGRES_USER=chatbi
POSTGRES_PASSWORD=chatbi
POSTGRES_DB=chatbi
