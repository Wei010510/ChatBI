# ChatBI 生产环境变量模板（不含真实值）
# 服务器真实文件为 backend/.env.production，权限 600，不提交 Git。
# 生产数据库使用 Supabase，不使用本地 db 容器。

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_RO_URL=
DATABASE_META_URL=
DATA_SCHEMA=public

LLM_BASE_URL=
LLM_API_KEY=
MODEL_SMALL=qwen3.8-flash
MODEL_STRONG=qwen3.8-flash
MODEL_MID=qwen3.8-flash

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
# 维度必须与 Supabase pgvector 建表及当前 Embedding 模型一致
EMBED_DIM=1536

QUERY_TIMEOUT_MS=5000
MAX_ROWS=1000
CACHE_TTL_SECONDS=604800
PGVECTOR_ENABLED=auto

# 生产必须为 false；docker-compose.production.yml 也会强制覆盖
USE_MOCK_LLM=false
